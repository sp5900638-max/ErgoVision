# ==============================================================================
# ERGOSENSE 360 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.prod: cp .env.example .env.prod
# Permissions: chmod 600 .env.prod (Ensure only deployment user can read)
# NEVER commit .env.prod or real credentials to Git version control.

# ==============================================================================
# ENVIRONMENT & RUNTIME SETTINGS
# ==============================================================================
ENVIRONMENT=production
DEBUG=False
APP_NAME="ErgoSense 360"

# Allowed CORS origins (comma-separated, no trailing slashes)
# In production, specify the exact domain(s)
ALLOWED_ORIGINS=https://ergosense.yourdomain.com

# Cryptographic token signing secret key (minimum 64 hex characters)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_cryptographically_secure_hex_token

# ==============================================================================
# PRIMARY DATABASE: POSTGRESQL 16
# ==============================================================================
POSTGRES_DB=ergosense_prod
POSTGRES_USER=ergosense_app

# High-entropy database password (minimum 24 characters)
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_high_entropy_alphanumeric_password

POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Async/Sync connection string
DATABASE_URL=postgresql://ergosense_app:replace_with_high_entropy_alphanumeric_password@db:5432/ergosense_prod

# ==============================================================================
# IN-MEMORY STORE & CACHE: REDIS 7
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# Redis authentication password (minimum 32 characters)
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace_with_32_character_hex_password
REDIS_URL=redis://:replace_with_32_character_hex_password@redis:6379/0

# ==============================================================================
# SECURITY & TELEMETRY RATE LIMITS
# ==============================================================================
SESSION_EXPIRY_MINUTES=480
RATE_LIMIT_GLOBAL_PER_SEC=30
RATE_LIMIT_AUTH_PER_MIN=5
MAX_TELEMETRY_PACKET_SIZE_KB=64
